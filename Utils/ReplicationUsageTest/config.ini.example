; 복제 usage 테스트 설정 템플릿. config.ini 로 복사해 값을 채운다 (*.ini 는 git 에 올라가지 않는다).

[portal]
; [필수] 포털 API 주소 (https://호스트:포트). 브라우저 UI 주소가 아니라 API 포트.
;   서버 /usr/local/ksan/etc/ksanAgent.conf 의 PortalHost·PortalPort 참고 (예: https://192.168.31.151:7553)
url =
; [필수] 포털 API 키 (Authorization: Bearer 로 보낸다)
;   ksanAgent.conf 의 PortalApiKey 값, 또는 포털 UI 에서 발급한 키
api_key =

[s3]
; [필수] S3 GW 주소 (예: http://192.168.31.151:7070)
url =
; [필수] S3 사용자 키. 버킷 생성·복제 설정·포털 버킷 조회(AccessKey/SecretKey 헤더)에 같이 쓴다
access_key =
secret_key =

[test]
; [선택] 업로드할 파일 개수. 비우면 10
file_count =
; [선택] 파일 크기 목록, 쉼표 구분, 단위 B/K/M/G (1024 배수). 비우면 0,1K,64K,1M
;   개수만큼 돌아가며 배정한다 (개수 10, 크기 4종 → 0,1K,64K,1M,0,1K,...). 하나만 쓰면 모두 같은 크기
;   파일은 메모리에서 만들어 단일 PUT 으로 올리므로 크기당 상한은 5G
file_sizes =
