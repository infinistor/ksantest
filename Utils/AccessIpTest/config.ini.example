; Access IP·버킷 QoS 테스트 설정 템플릿. config.ini 로 복사해 값을 채운다 (*.ini 는 git 에 올라가지 않는다).

[portal]
; [선택] 테스트 대상: ksan 또는 ifs(InfiniStor). 비우면 ksan. 실행할 때 --target 으로 바꿀 수 있다.
;   ifs 이면 아래 [ifs] 섹션도 채운다. 예전 이름 s3backend 와 [s3backend] 섹션도 그대로 읽는다.
type =
; [필수] 포털 API 주소 (https://호스트:포트). 브라우저 UI 주소가 아니라 API 포트.
;   KSAN: 서버 /usr/local/ksan/etc/ksanAgent.conf 의 PortalHost·PortalPort 참고 (예: https://192.168.11.151:7554)
url =
; [필수] 포털 API 키 (Authorization 헤더로 보낸다)
;   KSAN: ksanAgent.conf 의 PortalApiKey 값, 또는 포털 UI 에서 발급한 키
api_key =

[s3]
; [필수] S3 GW 주소 (예: http://192.168.11.152:7070)
url =

[test]
; [선택] 이 머신의 IP. 비우면 S3 주소로 나가는 출발지 IP 를 자동 감지한다.
;   NAT·프록시 뒤라서 GW 가 보는 IP 가 다르면 GW 가 보는 IP 를 적는다.
client_ip =
; [선택] Access IP 설정·해제 후 GW 반영까지 기다리는 초. 비우면 1
delay =

; 대상이 ifs 일 때만 읽는다. InfiniStor 는 볼륨에 사용자를 마운트해야 S3 키가 나온다.
[ifs]
; [선택] 테스트 사용자를 마운트할 볼륨. 비우면 accessipvol
;   없으면 만들어 시작하고, 꺼져 있으면 시작한다. 테스트가 끝나도 지우지 않는다.
volume_name =
; [선택] 볼륨을 새로 만들 때의 크기 (숫자 + MB·GB·TB). 비우면 100GB
volume_size =
; [필수] 볼륨을 새로 만들 때의 비밀번호
volume_password =
; [필수] 테스트 사용자의 비밀번호
user_password =
; [선택] 테스트 사용자의 쿼터 (숫자 + MB·GB·TB). 비우면 50GB
user_size =
